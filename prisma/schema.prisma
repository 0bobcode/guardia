generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DISTRICT_ADMIN
  PARENT
}

enum GradeBand {
  K_5
  G6_8
  G9_12
}

enum RiskLevel {
  NONE
  LOW
  MED
  HIGH
}

enum ScanAction {
  PASSED
  FLAGGED
  BLOCKED
}

enum ConsentStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

model District {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  // The latest Guardia OS version this district's admin has approved/
  // published from GuardRail Settings — the ceiling parents can install
  // up to from TrustEd. Format "major.minor.patch", e.g. "22.0.0".
  osVersion String   @default("22.0.0")

  users        User[]
  apps         App[]
  policies     Policy[]
  scanEvents   ScanEvent[]
  students     Student[]
  dailyStats   DailyStat[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  // null for SSO-provisioned accounts (no local password)
  name         String
  role         Role
  createdAt    DateTime @default(now())
  // The Guardia OS version this parent currently has installed (parents
  // only). Installed via TrustEd Settings, capped at their district's
  // District.osVersion — never typed in directly. Format "major.minor.patch".
  osVersion    String   @default("22.0.0")

  // "credentials" | "microsoft-entra-id" — which auth method provisioned/owns this account
  authProvider String  @default("credentials")
  externalId   String? // Azure AD object id (oid) for SSO-linked accounts

  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  // Parent-specific
  children Student[] @relation("ParentToStudent")

  @@unique([authProvider, externalId])
}

model Student {
  id           String   @id @default(cuid())
  name         String
  gradeBand    GradeBand
  email        String?
  passwordHash String?
  createdAt    DateTime @default(now())

  districtId String
  district   District @relation(fields: [districtId], references: [id])

  parentId String?
  parent   User?   @relation("ParentToStudent", fields: [parentId], references: [id])

  enrollments    StudentAppEnrollment[]
  scanEvents     ScanEvent[]
  consentRequests ConsentRequest[]
  aiSessions     AiSession[]
  devicePairings DevicePairing[]
  screenShares   ScreenShareSession[]
}

// A phone enrolled in TrustEd's device monitor. Created unpaired (a short
// code shown in the dashboard); the companion Android app exchanges that
// code for a long-lived token on first launch, then authenticates future
// ingest calls with the token.
model DevicePairing {
  id                 String    @id @default(cuid())
  pairCode           String    @unique
  token              String    @unique @default(cuid())
  deviceName         String?
  createdAt          DateTime  @default(now())
  pairedAt           DateTime?
  lastSeenAt         DateTime?
  // Set from TrustEd's Settings page; when present, the browser extension
  // must send the matching password to /api/device/unpair before it can
  // unpair itself — lets a parent gate unpairing remotely, without touching
  // the child's browser.
  unpairPasswordHash String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id])
}

// A live screen view a parent asked for. The child's device must accept every
// session (and the OS shows its own "sharing" indicator while it runs) — the
// parent can never start one on their own. The child is told, in the consent
// prompt itself, that pictures from the session are saved for the parent to
// review afterward (see ScreenShareFrame) — this isn't a quietly-added extra,
// it's part of what they're agreeing to each time.
enum ScreenShareStatus {
  REQUESTED
  ACTIVE
  ENDED
  DECLINED
  EXPIRED
}

model ScreenShareSession {
  id          String            @id @default(cuid())
  status      ScreenShareStatus @default(REQUESTED)
  requestedAt DateTime          @default(now())
  respondedAt DateTime?
  endedAt     DateTime?
  // "PARENT" | "CHILD" | "TIMEOUT"
  endedBy     String?
  lastFrame   Bytes? // the single live-view frame — overwritten continuously, gone once the session ends
  lastFrameAt DateTime?
  frameCount  Int               @default(0)

  requestedById String
  deviceId      String
  studentId     String
  student       Student @relation(fields: [studentId], references: [id])
  frames        ScreenShareFrame[]

  @@index([studentId, requestedAt])
}

// A sampled still from a screen-share session, kept for the parent to review
// after the session ends. Sampled roughly once every 10 seconds (not every
// live-view frame) to keep storage reasonable, and auto-deleted after
// SCREEN_FRAME_RETENTION_DAYS (src/lib/screenShare.ts) regardless of whether
// anyone ever looks at them.
model ScreenShareFrame {
  id         String   @id @default(cuid())
  image      Bytes
  capturedAt DateTime @default(now())

  sessionId String
  session   ScreenShareSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, capturedAt])
}

// AI apps / platforms integrated with GuardRail (e.g. Tutorly AI, MathBot K-5)
model App {
  id        String   @id @default(cuid())
  name      String
  subject   String
  provider  String   @default("anthropic") // "anthropic" | "openai" | "google"
  model     String   @default("claude-sonnet-5")
  createdAt DateTime @default(now())

  districtId String
  district   District @relation(fields: [districtId], references: [id])

  enrollments     StudentAppEnrollment[]
  scanEvents      ScanEvent[]
  consentRequests ConsentRequest[]
  aiSessions      AiSession[]

  @@unique([districtId, name])
}

// Which students use which apps, and daily usage tracking
model StudentAppEnrollment {
  id            String  @id @default(cuid())
  dailyLimitMin Int     @default(180)
  usedTodayMin  Int     @default(0)

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  appId String
  app   App    @relation(fields: [appId], references: [id])

  @@unique([studentId, appId])
}

// Grade-band safety policy: keyword categories + thresholds, editable by district admins
model Policy {
  id          String    @id @default(cuid())
  gradeBand   GradeBand
  category    String
  keywords    String // comma-separated keyword list
  action      ScanAction // action taken when this category matches at this grade band
  enabled     Boolean   @default(true)
  updatedAt   DateTime  @updatedAt

  districtId String
  district   District @relation(fields: [districtId], references: [id])

  @@unique([districtId, gradeBand, category])
}

// A single real-time content scan event (the core GuardRail log)
model ScanEvent {
  id          String     @id @default(cuid())
  queryText   String
  riskLevel   RiskLevel
  action      ScanAction
  categories  String // comma-separated matched category names
  gradeBand   GradeBand
  createdAt   DateTime   @default(now())

  districtId String
  district   District @relation(fields: [districtId], references: [id])

  appId String
  app   App    @relation(fields: [appId], references: [id])

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])
}

// Aggregate daily volume metrics for the compliance dashboard headline
// numbers (call volume at GuardRail's scale isn't reasonable to store as
// individual rows in a demo DB; audit-quality detail lives in ScanEvent).
model DailyStat {
  id               String   @id @default(cuid())
  date             DateTime
  apiCallsTotal    Int
  requestsBlocked  Int
  complianceScore  Float

  districtId String
  district   District @relation(fields: [districtId], references: [id])

  @@unique([districtId, date])
}

// Parental consent workflow (TrustEd)
model ConsentRequest {
  id          String        @id @default(cuid())
  reason      String
  status      ConsentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  respondedAt DateTime?
  expiresAt   DateTime

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  appId String
  app   App    @relation(fields: [appId], references: [id])
}

enum MessageRole {
  STUDENT
  ASSISTANT
}

// A full AI conversation GuardRail scanned turn-by-turn — what TrustEd's
// parent-facing session monitor renders as a transcript.
model AiSession {
  id        String    @id @default(cuid())
  startedAt DateTime
  endedAt   DateTime?

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  appId String
  app   App    @relation(fields: [appId], references: [id])

  messages SessionMessage[]
}

model SessionMessage {
  id            String      @id @default(cuid())
  role          MessageRole
  content       String
  riskLevel     RiskLevel   @default(NONE)
  action        ScanAction  @default(PASSED)
  parentFlagged Boolean     @default(false)
  createdAt     DateTime    @default(now())

  sessionId String
  session   AiSession @relation(fields: [sessionId], references: [id])
}

// Inbound inquiries from the public marketing site's contact form.
model ContactRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  organization String?
  interest     String
  message      String
  createdAt    DateTime @default(now())
}
