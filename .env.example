# Copy this file to .env and fill in the values you need.
# See README.md for what each variable does and which ones are optional.

# Not needed when running via `docker compose up` — that path sets this
# itself to point at the local Postgres container.
DATABASE_URL="postgresql://user:password@localhost:5432/guardia_db"

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Optional — enables live AI replies from that provider instead of the
# built-in simulated fallback.
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_API_KEY=""

# Optional — set all three to enable "Continue with Microsoft" SSO on login.
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
