<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#090C14">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Guardia Companion"
        android:textColor="#F1F5F9"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp"
        android:text="Not paired yet. Enter the code shown in TrustEd."
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/pairCodeInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Pairing code (e.g. E8VTLW)"
        android:inputType="textCapCharacters"
        android:textColor="#F1F5F9"
        android:textColorHint="#64748B"
        android:letterSpacing="0.15"
        android:textSize="20sp"
        android:gravity="center" />

    <Button
        android:id="@+id/pairButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="#2DD4BF"
        android:text="Pair device" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="24dp"
        android:background="#1F2937" />

    <TextView
        android:id="@+id/accessibilityStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Monitoring: off"
        android:textColor="#94A3B8"
        android:textSize="14sp" />

    <Button
        android:id="@+id/openAccessibilitySettingsButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enable monitoring in Settings" />

</LinearLayout>
